# ==========================================
# SupportMate AI - Environment Configuration
# ==========================================

# Required: Google Gemini API Key
# Obtain an API key for free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Required: Gemini Model Name (e.g. gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional: Public branding
NEXT_PUBLIC_APP_NAME=SupportMate AI
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Optional: Request timeout in milliseconds (default: 20000)
REQUEST_TIMEOUT_MS=20000

# Optional: Sliding-window rate limiter (default: 20 requests per 60000ms window per IP)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
